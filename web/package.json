    "@remotion/cli": "4.0.448",
    "@remotion/player": "4.0.448",
    "@types/three": "^0.184.0",
    "ai": "^6.0.168",
    "better-sqlite3": "^11.8.1",
    "ffmpeg-static": "^5.3.0",
    "lodash": "^4.18.1",
    "lucide-react": "1.8.0",
    "next": "16.2.4",
    "openai": "^6.34.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.448",
    "three": "^0.184.0",
    "vercel-minimax-ai-provider": "^0.0.2"
