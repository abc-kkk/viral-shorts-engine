{
  "name": "viral-shorts-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:ext": "tsc -p viral-shorts-extension/tsconfig.json && esbuild viral-shorts-extension/src/content.ts --bundle --outfile=viral-shorts-extension/dist/content.js",
    "build": "npm run build:ext && next build",
