generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id              String   @id
  projectName     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  currentPhase    Int      @default(1)
  
  artStyle        String?
  flowUrl         String?
  theme           String?
  aiProvider      String?
  useHitlMode     Boolean  @default(true)
  
  writerStep      Int      @default(1)
  creativeMode    String?
  rawScript       String?
  scriptIteration Int      @default(0)
  userDirection   String?
  
  publishInfo     String?  
  inspirations    String?  
  scriptReview    String?  
  
  locationPrompt  String?
  locationImage   String?
  
  activeSceneIndex Int     @default(0)
  
  characters      Character[]
  scenes          Scene[]
  covers          Cover[]
}

model Character {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  name        String
  persona     String?
  voiceName   String?
  
  prompt      String?
  imageUrl    String?

  @@unique([projectId, name])
}

model Scene {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneIndex        Int
  
  speaker           String?
  dialogue          String?
  actionHint        String?
  
  locationPrompt    String?
  actionLayoutPrompt String?
  imagePrompt       String?
  videoPrompt       String?
  startImagePrompt  String?
  
  locationImage     String?
  imageAsset        String?
  startImageAsset   String?
  videoAsset        String?
  audioAsset        String?
  
  charactersInScene String? 
  duration          Float?
  videoTrimStart    Float?
  videoTrimEnd      Float?
  audioDelay        Float?

  @@unique([projectId, sceneIndex])
}

model Cover {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  ratio       String
  prompt      String?
  imageUrl    String?

  @@unique([projectId, ratio])
}
